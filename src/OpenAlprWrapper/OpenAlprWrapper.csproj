<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Targets .NET 10 and .NET 8; .NET Framework is not supported (uses .NET 7+ APIs and modern C#) -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package metadata. Version is sourced from Version.props (semantic versioning). -->
    <PackageId>OpenAlprWrapper</PackageId>
    <Authors>OpenALPRWrapper contributors</Authors>
    <Description>.NET wrapper for OpenALPR license plate recognition. Provides P/Invoke bindings to the native OpenALPR C API.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/edward-hsu-1994/OpenAlprWrapper</PackageProjectUrl>
    <PackageTags>OpenALPR;license-plate-recognition;computer-vision;pinvoke;native</PackageTags>
    <RepositoryUrl>https://github.com/edward-hsu-1994/OpenAlprWrapper.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Internals visible to test assembly -->
    <InternalsVisibleTo Include="OpenAlprWrapper.Tests" />

    <!-- Package includes -->
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="/" />
  </ItemGroup>

  <!-- Version props file reference for semantic versioning -->
  <Import Project="Version.props" Condition="Exists('Version.props')" />
</Project>
